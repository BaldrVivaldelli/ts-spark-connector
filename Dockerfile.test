# Dockerfile for running tests with all dependencies
FROM node:20-alpine

# Install netcat for health checks
RUN apk add --no-cache netcat-openbsd

# Set working directory
WORKDIR /app

# Copy package files and config files first (for better Docker layer caching)
COPY package*.json tsconfig*.json ./

# Install dependencies (skip prepare script that requires source files)
RUN npm ci --ignore-scripts

# Copy source code and tests
COPY . .

# Copy data and only the public development CA needed by the E2E client. The
# server's PKCS#12 private key remains in the Spark image.
COPY ./example_data /data
COPY ./spark-server/certs/ca.crt /app/spark-server/certs/ca.crt

# Build the TypeScript code
RUN npm run build

# Spark is provided by docker-compose.test.yml, so this image runs only E2E.
CMD ["npm", "run", "test:e2e"]
